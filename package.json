{
  "name": "talking-marble-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter talking-marble gen && pnpm --filter site dev",
    "build": "pnpm --filter talking-marble build && pnpm --filter site build",
    "test": "pnpm --filter talking-marble test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
