{
  "name": "talking-marble",
  "version": "0.1.0",
  "description": "An audio-reactive orb for voice AI apps: shows what your agent is doing and moves with its voice. A React component and a Web Component.",
  "license": "MIT",
  "author": "Justin Liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjustinliao/Talking-Marble.git",
    "directory": "packages/react"
  },
  "homepage": "https://talking-marble.vercel.app/",
  "bugs": "https://github.com/imjustinliao/Talking-Marble/issues",
  "keywords": [
    "voice",
    "voice-ai",
    "voice-agent",
    "orb",
    "ai",
    "react",
    "react-component",
    "webgl",
    "web-audio",
    "audio",
    "audio-reactive",
    "visualizer",
    "web-component",
    "custom-element",
    "openai-realtime",
    "elevenlabs",
    "livekit"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts"
  ],
  "exports": {
    ".": {
      "talking-marble-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "talking-marble-source": "./src/element.ts",
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node scripts/gen-core.mjs",
    "build": "node scripts/gen-core.mjs && tsdown",
    "test": "node scripts/gen-core.mjs && vitest run",
    "typecheck": "node scripts/gen-core.mjs && tsc",
    "prepack": "node scripts/pack-files.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "vite": "8.3.8"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./element": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
