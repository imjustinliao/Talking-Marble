{
  "name": "talking-marble",
  "version": "0.0.0",
  "description": "An audio-reactive animated orb for voice AI apps.",
  "license": "MIT",
  "author": "Justin Liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjustinliao/Talking-Marble.git",
    "directory": "packages/react"
  },
  "keywords": [
    "voice",
    "orb",
    "ai",
    "react",
    "webgl",
    "audio",
    "visualizer"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "talking-marble-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node scripts/gen-core.mjs",
    "build": "node scripts/gen-core.mjs && tsdown",
    "test": "node scripts/gen-core.mjs && vitest run",
    "typecheck": "node scripts/gen-core.mjs && tsc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "vite": "8.3.8"
  }
}
